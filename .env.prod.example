API_IMAGE=123456789012.dkr.ecr.sa-east-1.amazonaws.com/service-order-api:latest
DATABASE_URL=postgresql+asyncpg://service_order_user:change-me@your-rds-endpoint:5432/service_order_db
ENVIRONMENT=production
APP_BASE_URL=http://EC2_PUBLIC_DNS_OR_IP:8000

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_AUTH=false
SMTP_TIMEOUT_SECONDS=10
SMTP_FROM_EMAIL=no-reply@example.com

APPROVAL_TOKEN_SECRET=change-me-use-a-long-random-string
APPROVAL_TOKEN_TTL_MINUTES=60
JWT_SECRET=change-me-use-a-different-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
