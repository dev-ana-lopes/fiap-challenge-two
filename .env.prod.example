APP_NAME=service-order-api
APP_VERSION=2.1.0
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_JSON=true
EMAIL_PROVIDER=NOOP
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
TRUSTED_HOSTS=api.example.com,localhost

DATABASE_URL=
APP_BASE_URL=https://api.example.com
HEALTHCHECK_TIMEOUT_SECONDS=5

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
SMTP_USE_TLS=false
SMTP_USE_AUTH=false
SMTP_TIMEOUT_SECONDS=10
SMTP_FROM_EMAIL=

APPROVAL_TOKEN_SECRET=
APPROVAL_TOKEN_SECRET_FILE=/run/secrets/approval_token_secret
APPROVAL_TOKEN_TTL_MINUTES=60
JWT_SECRET=
JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
