  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';",
          "",
          "function seedDigits(value) {",
          "  return String(value || Date.now()).replace(/\\D/g, '').padStart(9, '0').slice(-9);",
          "}",
          "",
          "function cpfCheckDigit(values) {",
          "  let factor = values.length + 1;",
          "  let total = 0;",
          "  values.forEach(function (value) {",
          "    total += value * factor;",
          "    factor -= 1;",
          "  });",
          "  const remainder = total % 11;",
          "  return remainder < 2 ? 0 : 11 - remainder;",
          "}",
          "",
          "function buildCpf(seedValue) {",
          "  const digits = seedDigits(seedValue).split('').map(function (digit) {",
          "    return Number(digit);",
          "  });",
          "  digits.push(cpfCheckDigit(digits));",
          "  digits.push(cpfCheckDigit(digits));",
          "  return digits.join('');",
          "}",
          "",
          "function buildPlate(seedValue) {",
          "  const digits = String(seedValue || Date.now()).replace(/\\D/g, '').slice(-4).padStart(4, '0');",
          "  const letterIndex = Number(digits[1]) % alphabet.length;",
          "  return 'TCW' + digits[0] + alphabet[letterIndex] + digits[2] + digits[3];",
          "}",
          "",
          "function initializeRun(forceRefresh) {",
          "  if (!forceRefresh && pm.environment.get('run_id')) {",
          "    return;",
          "  }",
          "",
          "  const runId = String(Date.now());",
          "  pm.environment.set('run_id', runId);",
          "  pm.environment.set('admin_email', 'admin+' + runId + '@example.com');",
          "  pm.environment.set('admin_password', 'Admin1234');",
          "  pm.environment.set('customer_email', 'maria+' + runId + '@example.com');",
          "  pm.environment.set('customer_cpf_cnpj', buildCpf(runId));",
          "  pm.environment.set('customer_name', 'Maria ' + runId);",
          "  pm.environment.set('vehicle_plate', buildPlate(runId));",
          "  pm.environment.set('service_description', 'Troca de oleo ' + runId);",
          "  pm.environment.set('part_name', 'Filtro ' + runId);",
          "  pm.environment.unset('access_token');",
          "  pm.environment.unset('token_type');",
          "  pm.environment.unset('customer_id');",
          "  pm.environment.unset('vehicle_id');",
          "  pm.environment.unset('service_id');",
          "  pm.environment.unset('part_id');",
          "  pm.environment.unset('service_order_id');",
          "}",
          "",
          "initializeRun(pm.info.requestName === 'GET /health');"
        ]
      }
    }
  ],
