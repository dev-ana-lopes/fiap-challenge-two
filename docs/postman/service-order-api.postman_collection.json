        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"John Doe\",\n  \"customer_email\": \"john.customer@example.com\",\n  \"customer_phone\": \"11999999999\",\n  \"vehicle_brand\": \"Toyota\",\n  \"vehicle_model\": \"Corolla\",\n  \"vehicle_year\": 2020,\n  \"vehicle_plate\": \"ABC{{randomInt}}\",\n  \"services\": [\n    { \"description\": \"Oil change\", \"price\": 50.0 }\n  ],\n  \"parts\": [\n    { \"name\": \"Oil filter\", \"price\": 30.0, \"quantity\": 1 }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/service-orders",
          "host": ["{{baseUrl}}"],
          "path": ["service-orders"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Has service_order_id', function () { pm.expect(json).to.have.property('service_order_id'); });",
              "pm.collectionVariables.set('serviceOrderId', json.service_order_id);"
