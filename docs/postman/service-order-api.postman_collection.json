    {
      "name": "Service Orders - List Active",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/service-orders",
          "host": ["{{baseUrl}}"],
          "path": ["service-orders"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Response is array', function () { pm.expect(json).to.be.an('array'); });",
              "pm.test('Created order is present', function () {",
              "  const ids = json.map(x => x.id);",
              "  pm.expect(ids).to.include(pm.collectionVariables.get('serviceOrderId'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Service Orders - Reject Budget (creates new OS, approved=false, validates exclusion)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"Jane Doe\",\n  \"customer_email\": \"jane.customer@example.com\",\n  \"customer_phone\": \"11999999998\",\n  \"vehicle_brand\": \"Honda\",\n  \"vehicle_model\": \"Civic\",\n  \"vehicle_year\": 2019,\n  \"vehicle_plate\": \"XYZ{{randomInt}}\",\n  \"services\": [\n    { \"description\": \"Brake check\", \"price\": 80.0 }\n  ],\n  \"parts\": []\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/service-orders",
          "host": ["{{baseUrl}}"],
          "path": ["service-orders"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Create HTTP 200', function () { pm.response.to.have.status(200); });",
              "const createJson = pm.response.json();",
              "pm.collectionVariables.set('serviceOrderId2', createJson.service_order_id);",
              "",
              "// Call approval(false) synchronously using pm.sendRequest",
              "pm.sendRequest({",
              "  url: pm.collectionVariables.get('baseUrl') + '/service-orders/' + pm.collectionVariables.get('serviceOrderId2') + '/approval',",
              "  method: 'POST',",
              "  header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.collectionVariables.get('token') },",
              "  body: { mode: 'raw', raw: JSON.stringify({ approved: false }) }",
              "}, function (err, res) {",
              "  pm.test('Reject approval HTTP 200', function () { pm.expect(res.code).to.eql(200); });",
              "  pm.test('Reject approval success true', function () { pm.expect(res.json()).to.have.property('success', true); });",
              "",
              "  pm.sendRequest({",
              "    url: pm.collectionVariables.get('baseUrl') + '/service-orders',",
              "    method: 'GET',",
              "    header: { 'Authorization': 'Bearer ' + pm.collectionVariables.get('token') }",
              "  }, function (err2, res2) {",
              "    pm.test('List HTTP 200', function () { pm.expect(res2.code).to.eql(200); });",
              "    const list = res2.json();",
              "    const ids = list.map(x => x.id);",
              "    pm.test('Rejected order is excluded (FINISHED)', function () {",
              "      pm.expect(ids).to.not.include(pm.collectionVariables.get('serviceOrderId2'));",
              "    });",
              "  });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "email", "value": "qa@example.com" },
    { "key": "password", "value": "ChangeMe123!" },
    { "key": "token", "value": "" },
    { "key": "serviceOrderId", "value": "" },
    { "key": "serviceOrderId2", "value": "" },
    { "key": "userId", "value": "" }
  ]
}

