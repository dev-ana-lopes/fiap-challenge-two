{
  "info": {
    "name": "Service Order Email Approval - Manual Flow",
    "_postman_id": "1d96784d-0c93-4afb-9528-c6c15c5c7af7",
    "description": "Focused Postman collection for the manual email approval scenario using MailHog or Testmail.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.globals.set('qa_guard_required_uuid', \"function qaGuardRequiredUuid(name) { const value = (pm.environment.get(name) || '').trim(); pm.test(name + ' is populated', function () { pm.expect(value, name + ' must be set by a previous request').to.match(/^[0-9a-fA-F-]{36}$/); }); return value; }\");",
          "pm.globals.set('qa_parse_json', \"function qaParseJson() { try { return pm.response.json(); } catch (error) { pm.test('response is valid JSON', function () { throw new Error('Response body is not valid JSON: ' + pm.response.text()); }); throw error; } }\");",
          "const now = Date.now();",
          "const namespace = (pm.environment.get('testmail_namespace') || '').trim();",
          "const userEmail = (pm.environment.get('user_email') || '').trim();",
          "if (!userEmail) {",
          "  const generatedUserEmail = namespace ? `${namespace}.email-approval-auth-${now}@inbox.testmail.app` : `qa_email_approval_auth_${now}@example.com`;",
          "  pm.environment.set('user_email', generatedUserEmail);",
          "}",
          "const orderEmail = (pm.environment.get('service_order_customer_email') || '').trim();",
          "if (!orderEmail) {",
          "  const generatedOrderEmail = namespace ? `${namespace}.email-approval-order-${now}@inbox.testmail.app` : `qa_email_approval_order_${now}@example.com`;",
          "  pm.environment.set('service_order_customer_email', generatedOrderEmail);",
          "}",
          "const pwd = (pm.environment.get('user_password') || '').trim();",
          "if (!pwd) { pm.environment.set('user_password', 'P0stmanPassw0rd!'); }"
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "00 - Health",
      "item": [
        {
          "name": "GET /health (200)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('body.status == ok', () => pm.expect(json).to.have.property('status', 'ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "10 - Auth",
      "item": [
        {
          "name": "POST /auth/register (201 or 409)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}" },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 or 409', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login-json (200) -> saves {{access_token}}",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login-json", "host": ["{{base_url}}"], "path": ["auth", "login-json"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "eval(pm.globals.get('qa_parse_json'));",
                  "const json = qaParseJson();",
                  "pm.test('has access_token', () => pm.expect(json).to.have.property('access_token'));",
                  "pm.environment.set('access_token', json.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "20 - Email Approval",
      "item": [
        {
          "name": "POST /service-orders (200) -> saves {{service_order_id_public_approval}}",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"QA Email Approval\",\n  \"customer_cpf_cnpj\": null,\n  \"customer_email\": \"{{service_order_customer_email}}\",\n  \"customer_phone\": \"11999999990\",\n  \"vehicle_brand\": \"Chevrolet\",\n  \"vehicle_model\": \"Onix\",\n  \"vehicle_year\": 2019,\n  \"vehicle_plate\": \"BRA3K45\",\n  \"services\": [\n    {\"description\": \"Email approval scenario\", \"price\": 150.0}\n  ],\n  \"parts\": [\n    {\"name\": \"Filtro\", \"price\": 35.0, \"quantity\": 1}\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/service-orders", "host": ["{{base_url}}"], "path": ["service-orders"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "eval(pm.globals.get('qa_parse_json'));",
                  "const json = qaParseJson();",
                  "pm.test('has service_order_id', () => pm.expect(json).to.have.property('service_order_id'));",
                  "pm.environment.set('service_order_id_public_approval', json.service_order_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /public/service-orders/{{service_order_id_public_approval}}/status (200)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/public/service-orders/{{service_order_id_public_approval}}/status", "host": ["{{base_url}}"], "path": ["public", "service-orders", "{{service_order_id_public_approval}}", "status"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "eval(pm.globals.get('qa_guard_required_uuid'));",
                  "qaGuardRequiredUuid('service_order_id_public_approval');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "eval(pm.globals.get('qa_parse_json'));",
                  "const json = qaParseJson();",
                  "pm.test('status WAITING_APPROVAL', () => pm.expect(json).to.have.property('status', 'WAITING_APPROVAL'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /public/service-orders/{{service_order_id_public_approval}}/approval?token={{approval_email_token}} (manual)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/public/service-orders/{{service_order_id_public_approval}}/approval?token={{approval_email_token}}",
              "host": ["{{base_url}}"],
              "path": ["public", "service-orders", "{{service_order_id_public_approval}}", "approval"],
              "query": [{ "key": "token", "value": "{{approval_email_token}}" }]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "eval(pm.globals.get('qa_guard_required_uuid'));",
                  "qaGuardRequiredUuid('service_order_id_public_approval');",
                  "const approvalToken = (pm.environment.get('approval_email_token') || '').trim();",
                  "pm.test('approval_email_token is populated', function () { pm.expect(approvalToken, 'Copy the token from MailHog or Testmail before running this request').to.not.equal(''); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "eval(pm.globals.get('qa_parse_json'));",
                  "const json = qaParseJson();",
                  "pm.test('success true', () => pm.expect(json).to.have.property('success', true));",
                  "pm.test('status IN_PROGRESS', () => pm.expect(json).to.have.property('status', 'IN_PROGRESS'));",
                  "pm.test('decision APPROVED', () => pm.expect(json).to.have.property('decision', 'APPROVED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /public/service-orders/{{service_order_id_public_approval}}/status after approval (200)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/public/service-orders/{{service_order_id_public_approval}}/status", "host": ["{{base_url}}"], "path": ["public", "service-orders", "{{service_order_id_public_approval}}", "status"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "eval(pm.globals.get('qa_guard_required_uuid'));",
                  "qaGuardRequiredUuid('service_order_id_public_approval');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "eval(pm.globals.get('qa_parse_json'));",
                  "const json = qaParseJson();",
                  "pm.test('status IN_PROGRESS', () => pm.expect(json).to.have.property('status', 'IN_PROGRESS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /public/service-orders/{{service_order_id_public_approval}}/approval invalid token (400)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/public/service-orders/{{service_order_id_public_approval}}/approval?token=invalid-token",
              "host": ["{{base_url}}"],
              "path": ["public", "service-orders", "{{service_order_id_public_approval}}", "approval"],
              "query": [{ "key": "token", "value": "invalid-token" }]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "eval(pm.globals.get('qa_guard_required_uuid'));",
                  "qaGuardRequiredUuid('service_order_id_public_approval');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "eval(pm.globals.get('qa_parse_json'));",
                  "const json = qaParseJson();",
                  "pm.test('has detail', () => pm.expect(json).to.have.property('detail'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
